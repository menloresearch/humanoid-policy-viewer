# Dependencies
/node_modules

# IDE - VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# IDE - JetBrains
.idea
*.iml
*.ipr
*.iws

# Local env files
.env
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Build files
/build

# Cache
.cache
.temp
dist

# Generated by a static-site build step in the repo that embeds the viewer:
# checkpoint .onnx copies and the /static-data/*.json derived from them for
# the static build. Regenerated on every static build; never meant to be
# committed.
/public/model-library/
/public/static-data/

# Test definitions (Trajectory Editor tests, incl. the bundled defaults) —
# local scratch data, entirely untracked. Keeping one in git is an intentional
# act: `git add -f benchmark/<file>.json`.
/benchmark

# Local policies dropped into the default model library (see models/README.md).
# Checkpoints are never committed; only the README that documents the folder is.
/models/*
!/models/README.md

# Benchmark run outputs — regenerated by the in-app benchmark, not versioned.
# The folder itself IS tracked (via benchmark_runs/.gitkeep) so it exists on a
# fresh clone; only its generated *.json runs are ignored. Keeping a specific
# run in git is an intentional act: `git add -f benchmark_runs/<run>.json`.
/benchmark_runs/*
!/benchmark_runs/.gitkeep
