# Dependencies
/node_modules

# IDE - VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# IDE - JetBrains
.idea
*.iml
*.ipr
*.iws

# Local env files
.env
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Build files
/build

# Cache
.cache
.temp
dist

# Generated by a static-site build step in the repo that embeds the viewer:
# policy .onnx copies and the /static-data/*.json derived from them for
# the static build. Regenerated on every static build; never meant to be
# committed.
/public/policy-library/
/public/static-data/

# Local benchmarks: the folders "New benchmark" and `npm run benchmark init` make.
# Benchmarks are published as Hugging Face datasets (with cyclotron), not kept in
# this repo (see docs/benchmarks.md); only default/, the example `npm run dev`
# opens and new benchmarks are copied from, is tracked.
/benchmarks/*
!/benchmarks/default/

# Local policies dropped into the default policy library (see policies/README.md).
# Policies are never committed; only the README that documents the folder is.
/policies/*
!/policies/README.md

# Benchmark results — written by `npm run benchmark` and the in-app benchmark, not versioned.
# The folder itself IS tracked (via benchmark_results/.gitkeep) so it exists on a
# fresh clone; only the results in it are ignored. Keeping a specific
# result in git is an intentional act: `git add -f benchmark_results/<result>`.
/benchmark_results/*
!/benchmark_results/.gitkeep
